# ==============================================
# BMS Project - Git Ignore Rules
# ==============================================

# -----------------------------------------------
# SENSITIVE: Database config (NEVER commit this!)
# -----------------------------------------------
includes/config.php

# -----------------------------------------------
# UPLOADS & USER-GENERATED CONTENT
# -----------------------------------------------
uploads/
documents/
downloads/

# -----------------------------------------------
# DATABASE BACKUPS & EXPORTS
# -----------------------------------------------
# Ignore everything under backups/ EXCEPT the .htaccess that locks the
# directory down. Without the !exception, the .htaccess would be hidden
# from git and lost on every fresh deploy, leaving .sql dumps publicly
# downloadable until someone manually recreated the file.
backups/*
!backups/.htaccess
*.sql
*.sql.gz
*.sql.zip

# EXCEPTION: the multi-tenant schema template is source, not a backup. Every new
# tenant database is built from this file, so it MUST be version-controlled and
# deployed — the blanket *.sql rule above would otherwise silently exclude it.
# It is schema-only (zero INSERT statements); no business data ever lives here.
!schema/tenant_schema_template.sql

# -----------------------------------------------
# LOG FILES
# -----------------------------------------------
*.log
api/debug_grn_log.txt

# -----------------------------------------------
# GENERATED DAILY REPORTS (local-only, never deploy)
# See scripts/clean_daily_reports.sh to purge these locally.
# -----------------------------------------------
/Report_*.html
/Report_*.md
/Report_*.pdf
docs/BMS_Daily_Report_*.html
docs/BMS_Daily_Report_*.pdf

# -----------------------------------------------
# WINDOWS SYSTEM FILES
# -----------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------
# MACOS SYSTEM FILES
# -----------------------------------------------
.DS_Store
.AppleDouble

# -----------------------------------------------
# IDE & EDITOR FILES
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.qodo/

# -----------------------------------------------
# COMPOSER DEPENDENCIES (if used)
# -----------------------------------------------
vendor/
composer.lock

# -----------------------------------------------
# NODE MODULES (if any frontend tooling)
# -----------------------------------------------
node_modules/
package-lock.json

# -----------------------------------------------
# SCRATCH / TEMP / TOOLING (local-only working dirs)
# Already-tracked files under these dirs remain tracked;
# this rule only stops NEW untracked files from being added.
# -----------------------------------------------
tmp/
scratch/
.claude/

# AI Assistant per-environment encryption secret (never commit)
includes/ai_app_secret.php

# Multi-tenant master key. Encrypts every tenant's DB password at rest in
# bms_control.tenants. Never commit; never regenerate (that would orphan every
# stored tenant credential). Production may supply it as $TENANT_CRED_KEY instead.
includes/tenant_cred_key.php
